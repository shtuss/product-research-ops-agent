        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"project_id\": {\n      \"type\": \"string\"\n    },\n    \"research_goal\": {\n      \"type\": \"string\"\n    },\n    \"executive_summary\": {\n      \"type\": \"string\"\n    },\n    \"key_findings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"finding\": {\n            \"type\": \"string\"\n          },\n          \"evidence_source\": {\n            \"type\": \"string\"\n          },\n          \"supporting_evidence\": {\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"finding\",\n          \"evidence_source\",\n          \"supporting_evidence\",\n          \"priority\"\n        ]\n      }\n    },\n    \"user_needs\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"need\": {\n            \"type\": \"string\"\n          },\n          \"supporting_evidence\": {\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"need\",\n          \"supporting_evidence\",\n          \"priority\"\n        ]\n      }\n    },\n    \"jobs_to_be_done\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"situation\": {\n            \"type\": \"string\"\n          },\n          \"motivation\": {\n            \"type\": \"string\"\n          },\n          \"expected_outcome\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"situation\",\n          \"motivation\",\n          \"expected_outcome\"\n        ]\n      }\n    },\n    \"product_opportunities\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"opportunity\": {\n            \"type\": \"string\"\n          },\n          \"rationale\": {\n            \"type\": \"string\"\n          },\n          \"evidence_source\": {\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"opportunity\",\n          \"rationale\",\n          \"evidence_source\",\n          \"priority\"\n        ]\n      }\n    },\n    \"roadmap\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"horizon\": {\n            \"type\": \"string\"\n          },\n          \"initiative\": {\n            \"type\": \"string\"\n          },\n          \"rationale\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"horizon\",\n          \"initiative\",\n          \"rationale\"\n        ]\n      }\n    },\n    \"design_recommendations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"research_limitations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"project_id\",\n    \"research_goal\",\n    \"executive_summary\",\n    \"key_findings\",\n    \"user_needs\",\n    \"jobs_to_be_done\",\n    \"product_opportunities\",\n    \"roadmap\",\n    \"design_recommendations\",\n    \"research_limitations\",\n    \"confidence\"\n  ]\n}"
